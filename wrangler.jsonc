{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9d869346-6bad-4f00-afa5-cb557040191a","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3d5f3979defb48aabbf2484ced2fcdd4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
